  "pages": [
    {
      "page": 1,
      "text": "404 Page Not Found \u2013 Volt Cyprus\n\nnav-menu#openSitesNav\">\n\nnav-menu#toggleLanguageMenu\">\n\nnav-menu#openSitesNav\">\n\nnav-menu#closeSitesNav\"\n\nclass=\"flex cursor-pointer items-center gap-3 text-body-2 text-purple-500 lg:hidden\">\n\n\u0397\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bd\u03b9\u03ba\u03cc \u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1 Volt\n\n\u03a4\u03bf Volt \u03b4\u03c1\u03b1\u03c3\u03c4\u03b7\u03c1\u03b9\u03bf\u03c0\u03bf\u03b9\u03b5\u03af\u03c4\u03b1\u03b9 \u03c3\u03b5 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b5\u03c2 \u03b1\u03c0\u03cc 30 \u03c7\u03ce\u03c1\u03b5\u03c2 \u03c3\u03b5 \u03cc\u03bb\u03b7 \u03c4\u03b7\u03bd \u0395\u03c5\u03c1\u03ce\u03c0\u03b7. \u0392\u03c1\u03b5\u03af\u03c4\u03b5 \u03cc\u03bb\u03bf\u03c5\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03b5\u03b8\u03bd\u03b9\u03ba\u03bf\u03cd\u03c2 \u03b9\u03c3\u03c4\u03cc\u03c4\u03bf\u03c0\u03bf\u03c5\u03c2 \u03c0\u03b1\u03c1\u03b1\u03ba\u03ac\u03c4\u03c9.\n\nnav-menu#closeSitesNav\">\n\nclass=\"flex cursor-pointer items-center gap-3 text-body-2 text-purple-500\">\n\nsearch#containerClicked search#submit\" action=\"https://voltcyprus.org/anazitisi\">\n\nsearch#search\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"inherit\">\n\nsearch#checkInput focus->nav-menu#openTab keyup->search#search keyup->search#checkInput\"\n\nname=\"q\" data-nav-menu-target=\"link\" data-title=\"6\">\n\nsearch#clearInput\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"17\" viewBox=\"0 0 16 17\" fill=\"none\">\n\nnav-menu#openTab\" data-nav-menu-target=\"link\"\n\ndata-nav-menu-target=\"link\" data-title=\"2\">\n\ndata-nav-menu-target=\"link\" data-title=\"3\">\n\ndata-nav-menu-target=\"link\" data-title=\"4\">\n\n\u039f\u03b9\u03ba\u03bf\u03bd\u03bf\u03bc\u03af\u03b1 \u03ba\u03b1\u03b9 \u039a\u03bf\u03b9\u03bd\u03c9\u03bd\u03b9\u03ba\u03ae \u0394\u03b9\u03ba\u03b1\u03b9\u03bf\u03c3\u03cd\u03bd\u03b7\n\n\u0395\u03c5\u03c1\u03ce\u03c0\u03b7 \u03ba\u03b1\u03b9 \u0395\u03be\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ae \u03a0\u03bf\u03bb\u03b9\u03c4\u03b9\u03ba\u03ae\n\n\u039f\u03b9\u03ba\u03bf\u03bd\u03bf\u03bc\u03af\u03b1 \u03ba\u03b1\u03b9 \u039a\u03bf\u03b9\u03bd\u03c9\u03bd\u03b9\u03ba\u03ae \u0394\u03b9\u03ba\u03b1\u03b9\u03bf\u03c3\u03cd\u03bd\u03b7\n\n\u0391\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03b1 \u0394\u03b9\u03ba\u03b1\u03b9\u03ce\u03bc\u03b1\u03c4\u03b1 \u03b3\u03b9\u03b1 \u03cc\u03bb\u03bf\u03c5\u03c2\n\n\u03a0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd \u03ba\u03b1\u03b9 \u0392\u03b9\u03ce\u03c3\u03b9\u03bc\u03b7 \u0391\u03bd\u03ac\u03c0\u03c4\u03c5\u03be\u03b7\n\n\u0395\u03c5\u03c1\u03ce\u03c0\u03b7 \u03ba\u03b1\u03b9 \u0395\u03be\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ae \u03a0\u03bf\u03bb\u03b9\u03c4\u03b9\u03ba\u03ae\n\n\u0394\u03b5\u03af\u03c4\u03b5 \u03cc\u03bb\u03b5\u03c2 \u03c4\u03b9\u03c2 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03ba\u03ad\u03c2\n\n\u0394\u03b7\u03bc\u03bf\u03c3\u03b9\u03b5\u03c5\u03bc\u03ad\u03bd\u03b1 \u0386\u03c1\u03b8\u03c1\u03b1/\u0391\u03c0\u03cc\u03c8\u03b5\u03b9\u03c2\n\n\u0395\u03ba\u03bb\u03b5\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf\u03b9 \u03b1\u03be\u03b9\u03c9\u03bc\u03b1\u03c4\u03bf\u03cd\u03c7\u03bf\u03b9\n\n\u0395\u03c0\u03b9\u03c4\u03c1\u03bf\u03c0\u03ad\u03c2 \u03a0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2 \u03a0\u03bf\u03bb\u03b9\u03c4\u03b9\u03ba\u03ae\u03c2\n\n20 \u039c\u03b1\u0390\u03bf\u03c5 2026 - \u0394\u03b5\u03bd \u03c0\u03c1\u03cc\u03bb\u03b1\u03b2\u03b1\u03bd \u03bd\u03b1 \u03b1\u03c5\u03be\u03ae\u03c3\u03bf\u03c5\u03bd \u03ba\u03b1\u03bd \u03c4\u03b7\u03bd \u03b5\u03ba\u03bb\u03bf\u03b3\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5\u03c2 \u03b4\u03cd\u03bd\u03b1\u03bc\u03b7 \u03ba\u03b1\u03b9 \u03ad\u03b2\u03b3\u03b1\u03bb\u03b1\u03bd \u03c4\u03b9\u03c2 \u03bc\u03ac\u03c3\u03ba\u03b5\u03c2.\n\n20 \u039c\u03b1\u0390\u03bf\u03c5 2026 - \u03a0\u03bf\u03b9\u03bf\u03c2 \u03ad\u03bc\u03b5\u03b9\u03bd\u03b5 \u03bd\u03b1 \u03c6\u03c5\u03bb\u03ac\u03b5\u03b9 \u03c4\u03bf\u03c5\u03c2 \u03b8\u03b5\u03c3\u03bc\u03bf\u03cd\u03c2;\n\n12 \u039c\u03b1\u03af\u03bf\u03c5 2026 - \u0391\u03b4\u03b5\u03b9\u03ac\u03b6\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03bb\u03af\u03bc\u03bd\u03b7 \u03a0\u03b1\u03c1\u03b1\u03bb\u03b9\u03bc\u03bd\u03af\u03bf\u03c5\n\n21 \u0391\u03c0\u03c1\u03b9\u03bb\u03af\u03bf\u03c5 2026 - \u03a3\u03c4\u03b1 \u03cc\u03c1\u03b9\u03b1 \u03c4\u03bf\u03c5\u03c2 \u03bf\u03b9 \u03ba\u03c4\u03b7\u03bd\u03bf\u03c4\u03c1\u03cc\u03c6\u03bf\u03b9, \u03bf \u03b1\u03c6\u03b8\u03ce\u03b4\u03b7\u03c2 \u03c0\u03c5\u03c1\u03b5\u03c4\u03cc\u03c2 \u03be\u03b5\u03c6\u03b5\u03cd\u03b3\u03b5\u03b9\n\n17 \u0391\u03c0\u03c1\u03b9\u03bb\u03af\u03bf\u03c5 2026 - \u0397 \u03c3\u03c4\u03b1\u03c3\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b3\u03b5\u03bd\u03bd\u03ac \u03ba\u03c1\u03af\u03c3\u03b5\u03b9\u03c2\n\n9 \u0391\u03c0\u03c1\u03b9\u03bb\u03af\u03bf\u03c5 2026 - \u03a3\u03c4\u03bf \u03ba\u03b5\u03bd\u03cc \u03b7 \u03b5\u03ba\u03b5\u03c7\u03b5\u03b9\u03c1\u03af\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03bf\u03bd \u039b\u03af\u03b2\u03b1\u03bd\u03bf\n\n\u0394\u03b5\u03af\u03c4\u03b5 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b1 \u03bd\u03ad\u03b1\n\n404 - \u0397 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1 \u03b4\u03b5\u03bd \u03b2\u03c1\u03ad\u03b8\u03b7\u03ba\u03b5\n\n\u039b\u03c5\u03c0\u03bf\u03cd\u03bc\u03b1\u03c3\u03c4\u03b5, \u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1 \u03c0\u03bf\u03c5 \u03b6\u03b7\u03c4\u03ae\u03c3\u03b1\u03c4\u03b5 \u03b4\u03b5\u03bd \u03c5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 (\u03c0\u03bb\u03ad\u03bf\u03bd). \u03a0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03bf\u03cd\u03bc\u03b5 \u03cc\u03bb\u03b1 \u03b1\u03c5\u03c4\u03ac \u03c4\u03b1 \u03bb\u03ac\u03b8\u03b7 \u03ba\u03b1\u03b9 \u03b8\u03b1 \u03b2\u03b5\u03bb\u03c4\u03b9\u03ce\u03c3\u03bf\u03c5\u03bc\u03b5 \u03c4\u03bf\u03bd \u03b9\u03c3\u03c4\u03cc\u03c4\u03bf\u03c0\u03cc \u03bc\u03b1\u03c2 \u03b1\u03bd\u03ac\u03bb\u03bf\u03b3\u03b1. \u03a1\u03af\u03be\u03c4\u03b5 \u03bc\u03b9\u03b1 \u03bc\u03b1\u03c4\u03b9\u03ac \u03c3"
    },
    {
      "page": 2,
      "text": "\u03c4\u03bf \u03bc\u03b5\u03bd\u03bf\u03cd \u03ba\u03b1\u03b9 \u03ba\u03ac\u03bd\u03c4\u03b5 \u03b1\u03bd\u03b1\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03ac\u03bd\u03c9 \u03b4\u03b5\u03be\u03b9\u03ac \u03b3\u03c9\u03bd\u03af\u03b1 \u03b1\u03c5\u03c4\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2, \u03bc\u03b5\u03c4\u03b1\u03b2\u03b5\u03af\u03c4\u03b5 \u03c3\u03c4\u03b7\u03bd\n\n\u03ae \u03b5\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03ae\u03c3\u03c4\u03b5 \u03bc\u03b1\u03b6\u03af \u03bc\u03b1\u03c2 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b2\u03c1\u03b5\u03af\u03c4\u03b5 \u03b1\u03c5\u03c4\u03cc \u03c0\u03bf\u03c5 \u03c8\u03ac\u03c7\u03bd\u03b1\u03c4\u03b5.\n\n\u03a3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1, \u03a3\u03c5\u03bb\u03bb\u03bf\u03b3\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1, \u03a3\u03c5\u03bd\u03c5\u03c0\u03b5\u03c5\u03b8\u03c5\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1\n\n\u03a3\u03c4\u03ae\u03c1\u03b9\u03be\u03b5 \u03c4\u03bf Volt \u03ba\u03b1\u03b9 \u03b2\u03bf\u03ae\u03b8\u03b7\u03c3\u03b5 \u03bc\u03b1\u03c2 \u03bd\u03b1 \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03af\u03be\u03bf\u03c5\u03bc\u03b5 \u03c4\u03b7\u03bd \u03b4\u03c1\u03ac\u03c3\u03b7 \u03bc\u03b1\u03c2!\n\n\u0395\u03b3\u03b3\u03c1\u03ac\u03c8\u03bf\u03c5 \u03c3\u03c4\u03bf newsletter \u03bc\u03b1\u03c2\n\n\u0395\u03b3\u03b3\u03c1\u03ac\u03c8\u03bf\u03c5 \u03c3\u03c4\u03bf newsletter \u03bc\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03bd\u03b7\u03bc\u03b5\u03c1\u03c9\u03b8\u03b5\u03af\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03cc\u03bb\u03b1 \u03c4\u03b1 \u03bd\u03ad\u03b1 \u03c4\u03bf\u03c5 Volt\n\n\u0395\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03ce\u03bd\u03b7\u03c3\u03b5 \u03bc\u03b1\u03b6\u03af \u03bc\u03b1\u03c2\n\n\u0393\u03b5\u03bd\u03b9\u03ba\u03ad\u03c2 \u03b5\u03c1\u03c9\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03c0\u03c1\u03bf\u03c4\u03ac\u03c3\u03b5\u03b9\u03c2\n\n\u03a4\u03cd\u03c0\u03bf\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03ad\u03c3\u03b1 \u03b5\u03bd\u03b7\u03bc\u03ad\u03c1\u03c9\u03c3\u03b7\u03c2"
    }
  ]
}